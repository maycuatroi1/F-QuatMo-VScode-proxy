# Server Settings
PORT=3000
NODE_ENV=production
RATE_LIMIT_PER_MINUTE=30
# Agent mode (x-client-type: quatmo-code) makes many tool-call requests per turn
RATE_LIMIT_AGENT_PER_MINUTE=120
# Upper bound for max_tokens / max_completion_tokens forwarded upstream
MAX_OUTPUT_TOKENS=8192

# ─── Security ────────────────────────────────────────────────────────────────
# Generate every secret with:  openssl rand -hex 32
# The server refuses to start in production with values that were committed to git.
# Public URL of this proxy (used to build download links instead of the Host header)
PUBLIC_BASE_URL=https://fvscode-proxy.iahn.hanoi.vn
# Allowed browser origins for CORS ("*.domain" = any https subdomain)
CORS_ORIGINS=*.iahn.hanoi.vn,vscode-webview://*,vscode-file://*
# Number of reverse proxies that append to X-Forwarded-For (pve01 traefik + Dokploy traefik = 2).
# Leave empty to keep legacy behaviour (left-most X-Forwarded-For).
TRUSTED_PROXY_HOPS=
# Hosts allowed in release downloadUrl / cdnUrl (https only)
RELEASE_ALLOWED_HOSTS=fvscode-proxy.iahn.hanoi.vn,s3-api.iahn.hanoi.vn
# Redis password (docker-compose uses it for both redis and REDIS_URL)
REDIS_PASSWORD=
# Upload limits for /session/upload-logs
MAX_UPLOAD_FILES=5000
MAX_UPLOAD_BYTES=104857600
MAX_REQUEST_BODY_BYTES=115343360

# ─── Client version gate ─────────────────────────────────────────────────────
# off | warn | enforce. Start with warn, switch to enforce once the new client is released.
CLIENT_GATE_MODE=warn
# Minimum app version (product.json "version"). Empty = no fixed minimum.
CLIENT_MIN_VERSION=
# true = every client must run the latest installer/patch release
CLIENT_REQUIRE_LATEST=false
# Minimum quatmo-code extension version (optional)
CLIENT_MIN_EXTENSION_VERSION=
# true = client on the latest version must match the published buildHash (sha256 of out/main.js)
CLIENT_REQUIRE_BUILD_HASH=false
# true = chat with a session token issued to a verified client is not re-checked (no mid-exam cut)
CLIENT_GATE_EXEMPT_VERIFIED_SESSIONS=true

# Redis Connection
REDIS_URL=redis://localhost:6379

# Proxy access key
# Leave empty to auto-generate a runtime key in the form sk-... and print it at startup.
PROXY_API_KEY=

# Admin Webapp Login Credentials
# Falls back to 'admin' / PROXY_API_KEY respectively if left blank.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT Secret Key for signing student exam tokens (Leave empty to auto-generate a secure random key at startup)
JWT_SECRET=

# Custom Upstream Model Configuration (Gemma)
CUSTOM_BASE_URL=https://quatmo-api.iahn.hanoi.vn/v1
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=gemma-4
# Optional extra aliases that should also resolve to the custom upstream.
# Example: CUSTOM_MODEL_ALIASES=gemma,qwen3-coder
CUSTOM_MODEL_ALIASES=

# Classifier Settings
CLASSIFIER_API_URL=http://127.0.0.1:8000/classify
# Optional API Key for securing the communication between the Proxy and the Classifier API
CLASSIFIER_API_KEY=

# Allowed Proxy Modes (CHAT = quatmo-chat only, AGENT = both quatmo-chat and quatmo-code)
# Allowed values: CHAT, AGENT (or combinations like CHAT,AGENT). Empty -> all clients are blocked.
ALLOWED_MODES=

# The exact signature (hmac-sha256:...) or raw base64 clientFingerprint expected for the latest version.
# If a request lacks or doesn't match this, it will log a warning.
LATEST_FINGERPRINT=

# AES-256-GCM encryption key for log files.
# Set this to a strong secret to encrypt logs/sessions/** and logs/global.log.
# Leave empty for plain JSON logs (dev mode).
LOG_ENCRYPT_KEY=

# S3 Monitor Log Storage
S3_ENABLED=true
S3_ENDPOINT=https://s3-api.iahn.hanoi.vn
S3_REGION=us-east-1
S3_BUCKET=f-vscode-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
